# --- Claude API ---
ANTHROPIC_API_KEY=

# --- Azure DevOps ---
# PAT scopes: Work Items (Read). Use Read & write only if you enable comments below.
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
# "@Me" = the PAT's owner. Or a display name / email.
AZURE_DEVOPS_ASSIGNED_TO=@Me
AZURE_DEVOPS_STATES=New
# Post the root cause + fix branch as a comment on each processed bug
AZURE_DEVOPS_POST_COMMENTS=false

# --- Workflow ---
CRON_SCHEDULE=0 * * * *
RUN_ON_START=true
PLANNER_EFFORT=medium
MAX_BUGS_PER_CYCLE=5
MAX_ATTEMPTS_PER_BUG=3
PROJECTS_FILE=config/projects.json
DATA_DIR=data
PORT=4000

# Protect the dashboard when deployed (recommended)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Demo mode: fake agents + demo project, no keys needed
MOCK_MODE=false
