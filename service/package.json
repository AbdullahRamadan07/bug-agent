{
  "name": "bug-agent",
  "version": "1.0.0",
  "description": "Hourly Azure DevOps bug-fixing workflow: Haiku poller -> Opus planner -> Sonnet fixers",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "tsx src/index.ts --mock",
    "cycle": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
